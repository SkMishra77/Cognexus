# Option A – Bedrock API key (bearer-token auth, recommended)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here

# Option B – Traditional IAM credentials (uncomment if not using a bearer token)
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_here

AWS_REGION=us-east-1
CLAUDE_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0
IMAGE_MODEL=amazon.nova-canvas-v1:0
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
TAVILY_API_KEY=tvly-your-key-here
DATABASE_URL=postgresql+asyncpg://cognexus:secret@postgres:5432/cognexus
REDIS_URL=redis://redis:6379
MAX_PDF_SIZE_MB=50
MAX_VIDEO_JOBS_PER_PAPER=5
MAX_LABS_PER_PAPER=7
